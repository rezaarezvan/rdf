\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt, blk/.style={draw, minimum width=10mm, minimum height=8mm}]
\node[blk] (kr) at (0, 0) {$K_r$};
\node[draw, circle, minimum size=4mm, inner sep=0pt] (s) at (1.8, 0) {};
\node[blk, minimum width=26mm] (p) at (4.4, 0) {$\dot{x} = Ax + Bu$};
