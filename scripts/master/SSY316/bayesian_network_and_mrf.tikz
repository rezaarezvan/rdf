\begin{tikzpicture}[>={Stealth[length=2.5mm]}, line width=0.8pt, v/.style={circle, draw, minimum size=10mm, inner sep=1pt}, obs/.style={v, fill=c8, fill opacity=0.35, text opacity=1}, f/.style={rectangle, fill, minimum size=3.5mm, inner sep=0pt}]
\foreach \s/\x in {bn/0, mrf/6} {
    \node[v] (\s4) at (\x, 0) {$x_4$};
    \node[v] (\s1) at (\x - 1.4, 2.6) {$x_1$};
    \node[v] (\s2) at (\x, 1.4) {$x_2$};
    \node[v] (\s3) at (\x + 1.4, 2.6) {$x_3$};
}
\foreach \a in {1, 2, 3} \draw[->] (bn\a) -- (bn4);
\foreach \a/\b in {1/4, 2/4, 3/4, 1/2, 2/3, 1/3} \draw (mrf\a) -- (mrf\b);
\end{tikzpicture}
