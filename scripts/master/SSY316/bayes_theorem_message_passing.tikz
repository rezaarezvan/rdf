\usetikzlibrary{positioning, calc}
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, line width=0.8pt, v/.style={circle, draw, minimum size=10mm, inner sep=1pt}, obs/.style={v, fill=c8, fill opacity=0.35, text opacity=1}, f/.style={rectangle, fill, minimum size=3.5mm, inner sep=0pt}]
\node[f, label=left:{$p(x)$}] (px) {};
\node[v, right=12mm of px] (x) {$x$};
\node[f, right=12mm of x, label=below:{$p(y \mid x)$}] (pyx) {};
\node[v, right=12mm of pyx] (y) {$y$};
\node[f, right=12mm of y, label=right:{$\delta(y - y_{\text{obs}})$}] (d) {};
\draw (px) -- (x) -- (pyx) -- (y) -- (d);
\foreach \a/\b/\c/\m/\dir in {px/x/c1/1/->, x/pyx/c2/3/<-, pyx/y/c8/2/<-, y/d/c8/2/<-} {
    \draw[\dir, \c, line width=1.2pt] ($(\a)!0.25!(\b) + (0, 0.45)$) -- node[above] {$\mu_\m$} ($(\a)!0.75!(\b) + (0, 0.45)$);
}
\end{tikzpicture}
