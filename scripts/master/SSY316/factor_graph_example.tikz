\begin{tikzpicture}[>={Stealth[length=2.5mm]}, line width=0.8pt, v/.style={circle, draw, minimum size=10mm, inner sep=1pt}, obs/.style={v, fill=c8, fill opacity=0.35, text opacity=1}, f/.style={rectangle, fill, minimum size=3.5mm, inner sep=0pt}]
\foreach \i/\l in {1/A, 2/B, 3/C, 4/D, 5/E} {
    \node[v] (x\i) at (1.5 * \i, 0) {$x_\i$};
    \node[f, label=below:{$f_\l$}] (f\l) at (1.5 * \i, -1.6) {};
}
\foreach \a/\b in {1/A, 1/C, 2/B, 2/C, 3/C, 3/D, 3/E, 4/D, 5/E} \draw (x\a) -- (f\b);
\begin{scope}[xshift=10.5cm]
    \node[v] (y1) at (0, 0) {$x_1$};
    \node[f, label=left:{$f_A$}] (gA) at (-0.8, -1.2) {};
    \node[f, label=right:{$f_C$}] (gC) at (0.8, -1.2) {};
    \node[v] (y2) at (0, -2.4) {$x_2$};
    \node[v] (y3) at (1.6, -2.4) {$x_3$};
    \node[f, label=left:{$f_B$}] (gB) at (0, -3.6) {};
    \node[f, label=right:{$f_D$}] (gD) at (0.9, -3.6) {};
    \node[f, label=right:{$f_E$}] (gE) at (2.3, -3.6) {};
    \node[v] (y4) at (0.9, -4.8) {$x_4$};
    \node[v] (y5) at (2.3, -4.8) {$x_5$};
    \foreach \a/\b in {y1/gA, y1/gC, y2/gC, y3/gC, y2/gB, y3/gD, y3/gE, y4/gD, y5/gE} \draw (\a) -- (\b);
\end{scope}
\end{tikzpicture}
