\usetikzlibrary{positioning}
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, line width=0.8pt, v/.style={circle, draw, minimum size=10mm, inner sep=1pt}, obs/.style={v, fill=c8, fill opacity=0.35, text opacity=1}, f/.style={rectangle, fill, minimum size=3.5mm, inner sep=0pt}]
\node[c1, font=\bfseries] at (0, 1.2) {Tail-to-tail};
\node[obs] (c1) at (0, 0) {$c$};
\node[v] (a1) at (-1.1, -1.4) {$a$};
\node[v] (b1) at (1.1, -1.4) {$b$};
\draw[->] (c1) -- (a1);
\draw[->] (c1) -- (b1);
\node[c1, font=\bfseries] at (4.6, 1.2) {Head-to-tail};
\node[v] (a2) at (3.2, 0) {$a$};
\node[obs] (c2) at (4.6, 0) {$c$};
\node[v] (b2) at (6, 0) {$b$};
\draw[->] (a2) -- (c2);
\draw[->] (c2) -- (b2);
\node[c1, font=\bfseries] at (9.2, 1.2) {Head-to-head};
\node[v] (a3) at (8.1, 0) {$a$};
\node[v] (b3) at (10.3, 0) {$b$};
\node[v] (c3) at (9.2, -1.4) {$c$};
\draw[->] (a3) -- (c3);
\draw[->] (b3) -- (c3);
\end{tikzpicture}
