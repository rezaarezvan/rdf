\usetikzlibrary{fit, calc}
\begin{tikzpicture}[>={Stealth[length=2.5mm]}, line width=0.8pt, v/.style={circle, draw, minimum size=10mm, inner sep=1pt}, obs/.style={v, fill=c8, fill opacity=0.35, text opacity=1}, f/.style={rectangle, fill, minimum size=3.5mm, inner sep=0pt}]
\node[v] (x3) at (0, 0) {$x_3$};
\node[v] (x1) at (-1.6, 1.6) {$x_1$};
\node[v] (x2) at (-1.6, -1.6) {$x_2$};
\node[v] (x4) at (1.6, 1.6) {$x_4$};
\node[v] (x5) at (1.6, -1.6) {$x_5$};
\node[v] (x6) at (3.8, -1.6) {$x_6$};
\foreach \a/\b in {x1/x2, x1/x3, x2/x3, x3/x4, x3/x5, x4/x5, x5/x6} \draw (\a) -- (\b);
\draw[c1, line width=1.2pt, rounded corners=5mm] ($(x1) + (-0.8, 1.1)$) -- ($(x2) + (-0.8, -1.1)$) -- ($(x3) + (1.1, 0)$) -- cycle;
\draw[c8, line width=1.2pt, rounded corners=5mm] ($(x4) + (0.8, 1.1)$) -- ($(x5) + (0.8, -1.1)$) -- ($(x3) + (-1.1, 0)$) -- cycle;
\node[draw=c2, line width=1.2pt, rounded corners=5mm, inner sep=1.5mm, fit=(x5)(x6)] {};
\end{tikzpicture}
