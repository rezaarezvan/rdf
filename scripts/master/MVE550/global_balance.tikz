\usetikzlibrary{positioning}
\begin{tikzpicture}[>={Stealth[length=3mm]}, line width=0.9pt,
    v/.style={circle, draw, minimum size=12mm, font=\large},
    e/.style={->, bend left=20}]
\node[v] (s1) {1};
\node[v, right=30mm of s1] (s2) {2};
\node[v, below=22mm of $(s1)!0.5!(s2)$] (s3) {3};
\draw[e] (s1) to node[above] {1} (s2);
\draw[e] (s2) to node[below] {2} (s1);
\draw[e] (s2) to node[right] {1} (s3);
\draw[e] (s3) to node[left] {2} (s2);
\draw[e] (s3) to node[left] {2} (s1);
\draw[e] (s1) to node[right] {1} (s3);
\end{tikzpicture}
