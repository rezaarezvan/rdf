\begin{tikzpicture}[x=5mm, y=5mm, line width=0.5pt]
\newcommand{\grid}[4]{\draw[shift={(#1, #2)}, step=5mm] (0, 0) grid (#3, #4); \draw (#1, #2) rectangle ++(#3, #4);}
\newcommand{\cols}[5]{\foreach \c [count=\k from 0] in {#5} \fill[\c, opacity=0.35] (#1+\k, #2) rectangle ++(1, #4); \grid{#1}{#2}{#3}{#4}}
\newcommand{\rows}[5]{\foreach \c [count=\k from 0] in {#5} \fill[\c, opacity=0.35] (#1, #2+#4-1-\k) rectangle ++(#3, 1); \grid{#1}{#2}{#3}{#4}}
\newcommand{\ident}[3]{\foreach \r in {1,...,#3} \foreach \c in {1,...,#3} {\ifnum\r=\c \node[font=\footnotesize] at (#1+\c-0.5, #2+#3-\r+0.5) {1}; \else \node[font=\footnotesize, opacity=0.35] at (#1+\c-0.5, #2+#3-\r+0.5) {0}; \fi} \grid{#1}{#2}{#3}{#3}}
\fill[c7, opacity=0.35] (0, 0) rectangle (3, 4); \grid{0}{0}{3}{4}
\node at (4.4, 2) {\Large $=$};
\cols{5.5}{0}{4}{4}{c3,c2,c8,c6}
\foreach \k/\c in {0/c1,1/c5,2/c6} \fill[\c, opacity=0.35] (10.5+\k, 3-\k) rectangle ++(1, 1);
\foreach \r in {0,...,3} \foreach \c in {0,...,2} {\ifnum\r=\c \else \node[font=\footnotesize, opacity=0.35] at (11+\c, 3.5-\r) {0}; \fi}
\grid{10.5}{0}{3}{4}
\rows{14.5}{1}{3}{3}{c4,c1,c5}
\foreach \x/\l/\d in {1.5/\mathbf{M}/m \times n, 7.5/\mathbf{U}/m \times m, 12/\mathbf{\Sigma}/m \times n, 16/\mathbf{V}^*/n \times n} {
    \node at (\x, -0.8) {\Large $\l$};
    \node at (\x, -1.8) {$\d$};
}
\begin{scope}[yshift=-4.4cm]
\cols{2}{0}{4}{4}{c3,c2,c8,c6}
\rows{7}{0}{4}{4}{c3,c2,c8,c6}
\node at (12.4, 2) {\Large $=$};
\ident{13.5}{0}{4}
\foreach \x/\l in {4/\mathbf{U}, 9/\mathbf{U}^*, 15.5/\mathbf{I}_m} \node at (\x, -0.8) {\Large $\l$};
\end{scope}
\begin{scope}[yshift=-7.8cm]
\cols{2.5}{0}{3}{3}{c4,c1,c5}
\rows{7.5}{0}{3}{3}{c4,c1,c5}
\node at (12.4, 1.5) {\Large $=$};
\ident{14}{0}{3}
\foreach \x/\l in {4/\mathbf{V}, 9/\mathbf{V}^*, 15.5/\mathbf{I}_n} \node at (\x, -0.8) {\Large $\l$};
\end{scope}
\end{tikzpicture}
