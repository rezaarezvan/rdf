\usetikzlibrary{decorations.pathreplacing}
\begin{tikzpicture}[american, every node/.style={}, line width=0.7pt, >={Stealth[length=2.2mm]}, oa/.style={op amp, fill=c3, fill opacity=0.18, text opacity=1}]
\draw (0,0) to[V, l=$v_s$, invert] (0,3) to[R, l=$R_s$] (2.6,3) node[ocirc]{} -- (4.2,3) to[R, l_=$R_i$] (4.2,0) -- (2.6,0) node[ocirc]{} -- (0,0);
\node at (2.6,2.3) {$+$}; \node at (2.6,1.5) {$v_i$}; \node at (2.6,0.7) {$-$};
\draw[->] (2.9,3.4) -- (3.7,3.4) node[midway, above] {$i_i$};
\draw (7.2,0) to[cV, l=$A_{v\mathrm{oc}} v_i$, invert] (7.2,3) to[R, l=$R_o$] (9.4,3) node[ocirc]{} -- (11,3) to[R, l=$R_L$] (11,0) -- (9.4,0) node[ocirc]{} -- (7.2,0);
\node at (9.4,2.3) {$+$}; \node at (9.4,1.5) {$v_o$}; \node at (9.4,0.7) {$-$};
