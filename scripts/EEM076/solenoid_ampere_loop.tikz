}
\foreach \y in {2.73, 3.27, -0.93, -1.47} {\draw[dashed, line width=0.5pt] (-1.2, \y) -- (-0.3, \y); \draw[dashed, line width=0.5pt] (6.9, \y) -- (7.8, \y);}
\foreach \y in {2.2, 1.4, 0.6, -0.2} \draw[->, c8, line width=1.2pt] (-1.2, \y) -- (7.6, \y);
