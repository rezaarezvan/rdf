\begin{tikzpicture}[american, every node/.style={}, line width=0.7pt, >={Stealth[length=2.2mm]}, oafill/.style={fill=c3, fill opacity=0.18, draw opacity=0, text opacity=0}]
\node[op amp, noinv input up, oafill] at (0,0) {};
\node[op amp, noinv input up] (A) at (0,0) {};
\draw (A.+) -- ++(-0.6,0) node[ocirc, label=left:$V_+$]{};
\draw (A.-) -- ++(-0.6,0) node[ocirc, label=left:$V_-$]{};
\draw (A.out) -- ++(0.6,0) node[ocirc, label=above:$V_{\mathrm{out}}$]{};
\draw (A.up) -- ++(0,0.5) node[ocirc, label=above:$V_{S+}$]{};
\draw (A.down) -- ++(0,-0.5) node[ocirc, label=below:$V_{S-}$]{};
\end{tikzpicture}
