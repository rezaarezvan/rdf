\begin{tikzpicture}[x={(1cm, -0.18cm)}, y={(0cm, 1cm)}, z={(-0.55cm, -0.42cm)}, >={Stealth[length=2.2mm]}, line width=0.8pt]
\draw[->] (0, 0, 0) -- (9, 0, 0) node[right] {$x$};
\draw[->] (0, 0, 0) -- (0, 3, 0) node[above] {$y$};
\draw[->] (0, 0, 0) -- (0, 0, 3.2) node[below left] {$z$};
\fill[c5, fill opacity=0.25] plot[domain=0:8, samples=80] (\x, {1.6*sin(\x*90)}, 0) -- cycle;
\draw[c5] plot[domain=0:8, samples=80] (\x, {1.6*sin(\x*90)}, 0);
\fill[c8, fill opacity=0.12] plot[domain=0:8, samples=80] (\x, 0, {1.6*sin(\x*90)}) -- cycle;
\draw[c8] plot[domain=0:8, samples=80] (\x, 0, {1.6*sin(\x*90)});
\foreach \x in {0.5, 1, 1.5, 2.5, 3, 3.5, 4.5, 5, 5.5, 6.5, 7, 7.5} {
  \draw[->, c5, line width=1.1pt] (\x, 0, 0) -- (\x, {1.6*sin(\x*90)}, 0);
  \draw[->, c8, line width=1.1pt] (\x, 0, 0) -- (\x, 0, {1.6*sin(\x*90)});
}
\node[c5] at (1, 2.1, 0) {$\vec{\mathbf{E}}$};
\node[c8] at (0.6, 0, 2.4) {$\vec{\mathbf{B}}$};
\draw[->, c1, line width=1.5pt] (5, 2.2, 0) -- (6.5, 2.2, 0) node[midway, above] {$c$};
\end{tikzpicture}
