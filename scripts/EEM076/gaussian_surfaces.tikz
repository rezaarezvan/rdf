\begin{tikzpicture}[line width=0.8pt,
  e/.style={c5, line width=1.1pt, -{Stealth[length=2mm]}},
  a/.style={line width=1.1pt, -{Stealth[length=2mm]}},
  lab/.style={font=\small}]
\begin{scope}
  \node at (0, 3.3) {Sphere charge};
  \node at (0, -3.2) {Concentric sphere};
  \draw[c8, dashed] (0, 0) circle (1.1);
  \foreach \a in {0, 30, ..., 330} \draw[e] (\a:0.35) -- (\a:1.8);
  \fill[c5] (0, 0) circle (0.3);
  \node at (0, 0) {$+$};
  \node at (1.9, 1.4) {$\vec{\mathbf{E}}$};
\end{scope}
\begin{scope}[xshift=5.6cm]
  \node at (0, 3.3) {Line charge};
  \node at (0, -3.2) {Concentric cylinder};
  \fill[c5, fill opacity=0.5] (-2.4, -0.12) rectangle (2.4, 0.12);
  \foreach \x in {-2.15, -1.65, 1.65, 2.15} \node[lab] at (\x, 0) {$+$};
  \fill[c2, fill opacity=0.25] (-1.2, -0.9) -- (1.2, -0.9) arc (-90:90:0.3 and 0.9) -- (-1.2, 0.9) arc (90:270:0.3 and 0.9);
  \draw (-1.2, 0.9) -- (1.2, 0.9);
  \draw (-1.2, -0.9) -- (1.2, -0.9);
  \draw (-1.2, 0) ellipse (0.3 and 0.9);
  \draw (1.2, -0.9) arc (-90:90:0.3 and 0.9);
  \draw[dashed] (1.2, 0.9) arc (90:270:0.3 and 0.9);
  \draw[e] (-1.2, -0.3) -- (-1.2, -1.9) node[below, black] {$\vec{\mathbf{E}}_1$};
  \draw[a] (-1.3, -0.3) -- (-2.1, -0.3) node[below] {$d\vec{\mathbf{A}}_1$};
  \draw[e] (1.2, 0.3) -- (1.2, 1.8) node[above, black] {$\vec{\mathbf{E}}_2$};
  \draw[a] (1.3, 0.3) -- (2.1, 0.3) node[above] {$d\vec{\mathbf{A}}_2$};
  \draw[e] (0, 0.9) -- (-0.2, 2) node[above, black] {$\vec{\mathbf{E}}_3$};
  \draw[a] (0.1, 0.9) -- (0.3, 1.6) node[right] {$d\vec{\mathbf{A}}_3$};
  \node[lab] at (-0.9, -0.6) {$S_1$};
  \node[lab] at (1.5, -0.6) {$S_2$};
  \node[lab] at (0, -1.15) {$\ell$};
  \draw (-1.2, 0) -- node[lab, above left=-2pt] {$r$} (-1.2, 0.9);
\end{scope}
\begin{scope}[xshift=11cm]
  \node at (0, 3.3) {Planar charge};
  \node at (0, -3.2) {Gaussian pillbox};
  \fill[c2, fill opacity=0.25] (-0.7, -1.4) rectangle (0.7, 1);
  \fill[c6, fill opacity=0.35] (-2.2, -0.5) -- (1.4, -0.5) -- (2.2, 0.3) -- (-1.4, 0.3) -- cycle;
  \foreach \x in {-1.4, -0.9, ..., 1.6} \node[lab] at (\x, -0.1) {$+$};
  \draw (-0.7, 1) -- (-0.7, -1.4);
  \draw (0.7, 1) -- (0.7, -1.4);
  \draw (0, 1) ellipse (0.7 and 0.22);
  \draw (-0.7, -1.4) arc (180:360:0.7 and 0.22);
  \node[lab] at (-0.35, 1) {$S_1$};
  \node[lab] at (0.3, -1.25) {$S_2$};
  \draw[e] (0, 1) -- (0, 2.1) node[above, black] {$\vec{\mathbf{E}}_1$};
  \draw[a] (0.12, 1) -- (0.12, 1.6) node[right] {$d\vec{\mathbf{A}}_1$};
  \draw[e] (0, -1.4) -- (0, -2.1) node[right, black] {$\vec{\mathbf{E}}_2$};
  \draw[a] (-0.12, -1.4) -- (-0.12, -1.9) node[left] {$d\vec{\mathbf{A}}_2$};
  \draw[a] (0.7, 0.6) -- (1.4, 0.6) node[right] {$d\vec{\mathbf{A}}_3$};
\end{scope}
\end{tikzpicture}
