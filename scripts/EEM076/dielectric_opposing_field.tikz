\begin{tikzpicture}[>={Stealth[length=2.6mm]}, line width=0.8pt]
\newcommand{\dip}[3]{\begin{scope}[shift={(#1, #2)}, rotate=#3]
  \fill[c8, fill opacity=0.55] (0, 0.18) arc (90:270:0.45 and 0.18) -- cycle;
  \fill[c1, fill opacity=0.55] (0, 0.18) arc (90:-90:0.45 and 0.18) -- cycle;
  \draw[line width=0.5pt] (0, 0) ellipse (0.45 and 0.18);
  \node[scale=0.7] at (-0.22, 0) {$-$}; \node[scale=0.7] at (0.22, 0) {$+$};
\end{scope}}
\draw[line width=0.6pt] (0, 0) rectangle (4, 2.6);
\foreach \x/\y/\a in {0.6/2.1/10, 1.9/2.1/-5, 3.3/2.1/15, 0.6/1.3/-10, 1.9/1.3/5, 3.3/1.3/-15, 0.6/0.5/5, 1.9/0.5/15, 3.3/0.5/-25} \dip{\x}{\y}{\a}
\draw[->, c1, line width=1.4pt] (0.6, -0.4) -- (3.2, -0.4) node[right, black] {$\vec{\mathbf{E}}_0$};
\draw[->, c8, line width=1.4pt] (2.9, -1.0) -- (0.9, -1.0) node[left] {$\vec{\mathbf{E}}_p$};
\draw[line width=0.6pt] (6, 0) rectangle (10, 2.6);
\foreach \x in {6.6, 7.53, 8.47, 9.4} \foreach \y in {0.5, 1.3, 2.1} {\fill[c2, fill opacity=0.35] (\x, \y) circle (0.3); \node[scale=0.75] at (\x, \y) {$-\,+$};}
\draw[->, c1, line width=1.4pt] (6.6, -0.4) -- (9.2, -0.4) node[right, black] {$\vec{\mathbf{E}}_0$};
\draw[->, c8, line width=1.4pt] (8.7, -1.0) -- (7.1, -1.0) node[left] {$\vec{\mathbf{E}}_p$};
\end{tikzpicture}
