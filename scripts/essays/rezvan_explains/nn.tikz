\begin{tikzpicture}[
    node distance=0.8cm,
    line width=0.8pt,
    >={Stealth[length=2.5mm]},
    unit/.style={circle, draw, minimum size=9mm}
]
\foreach \l/\x/\s in {input/0/x, layer/2.9/a, output/5.8/y} {
    \node[unit] (\l1) at (\x, 0) {$\s_1$};
    \node[unit] (\l2) at (\x, -1.7) {$\s_2$};
    \node[unit] (\l3) at (\x, -3.4) {$\ldots$};
    \node[unit] (\l4) at (\x, -5.1) {$\s_n$};
}
\foreach \i in {1,...,4}
    \foreach \j in {1,...,4} {
        \draw[->] (input\i) -- (layer\j);
        \draw[->] (layer\i) -- (output\j);
    }
\node[above=0.3cm of input1] {Input layer};
\node[above=0.3cm of layer1] {Hidden layer};
\node[above=0.3cm of output1] {Output layer};
\end{tikzpicture}
