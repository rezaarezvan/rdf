\begin{tikzpicture}[
    node distance=0.8cm,
    line width=0.8pt,
    >={Stealth[length=2.5mm]},
    unit/.style={circle, draw, minimum size=9mm},
    box/.style={rectangle, draw, minimum height=9mm, minimum width=11mm}
]
\node[unit] (x1) {$x_1$};
\node[unit, below=of x1] (xj) {$\ldots$};
\node[unit, below=of xj] (xn) {$x_n$};
\node[unit, right=1.6cm of xj] (sum) {$\Sigma$};
\node[unit, above=of sum] (b) {$b$};
\node[box, right=1.2cm of sum] (f) {$f$};
\node[unit, right=1.2cm of f] (y) {$y$};
\draw[->] (x1) -- node[above right, pos=0.35] {$w_1$} (sum);
\draw[->] (xj) -- node[above, pos=0.4] {$w_j$} (sum);
\draw[->] (xn) -- node[below right, pos=0.35] {$w_n$} (sum);
\draw[->] (b) -- (sum);
\draw[->] (sum) -- node[above] {$z$} (f);
\draw[->] (f) -- (y);
\node[above=0.3cm of x1] {Inputs};
\node[above=0.3cm of b] {Summation};
\node at (f |- b.north) [anchor=south, yshift=0.3cm] {Activation};
\node at (y |- b.north) [anchor=south, yshift=0.3cm] {Output};
\end{tikzpicture}
