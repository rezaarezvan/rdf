\begin{tikzpicture}[
  adt/.style={draw=c1, fill=c1, fill opacity=0.12, text opacity=1, rounded corners=3pt, inner sep=4pt, font=\bfseries},
  impl/.style={text=c7, font=\small, align=center},
  edge/.style={draw=c1, line width=0.9pt},
]
\node[adt] (col) at (6.2, 0) {Collection<E>};
\node[adt] (map) at (13, -0.9) {Map<K,V>};
\node[adt] (stack) at (0, -2) {Stack<E>};
\node[adt] (queue) at (2.3, -2.9) {Queue<E>};
\node[adt, draw opacity=0.5, text opacity=0.6] (deque) at (0.6, -4) {Deque<E>};
\node[adt] (list) at (3.4, -4.6) {List<E>};
\node[adt] (pq) at (6.8, -2.5) {PriorityQueue<E>};
\node[adt] (set) at (10.4, -2.1) {Set<E>};
\node[adt] (sset) at (10.2, -4.6) {SortedSet<E>};
\node[adt] (smap) at (13, -3.7) {SortedMap<K,V>};
\node[adt] (graph) at (6.8, -5.4) {Graph<N>};

\foreach \n in {stack, queue, list, pq, set} \draw[edge] (col) -- (\n);
\draw[edge, dotted] (col) -- (map);
\draw[edge] (map) -- (smap);
\draw[edge] (set) -- (sset);
\draw[edge, draw opacity=0.4] (stack) -- (deque) -- (queue);

\node[impl] at (1.6, -5.7) {linked list, dynamic array};
\node[impl] at (6.8, -3.5) {binary heap\\[-1pt]{\footnotesize(meldable heap, Fibonacci heap)}};
\node[impl] at (12.2, -2.1) {hash table};
\node[impl] at (6.8, -6.3) {adjacency list, adjacency matrix};
\node[impl] at (11.9, -5.7) {linked list, dynamic array,\\binary search tree, red-black tree, AVL tree};
\end{tikzpicture}
