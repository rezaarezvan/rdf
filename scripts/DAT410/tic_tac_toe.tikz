\begin{tikzpicture}[line width=1.2pt, x=1.4cm, y=1.4cm]
\draw (1, 0) -- (1, 3) (2, 0) -- (2, 3) (0, 1) -- (3, 1) (0, 2) -- (3, 2);
\foreach \x/\y in {0/2, 1/1, 2/0, 2/2} {
    \draw[c8, line width=2.4pt] (\x + 0.22, \y + 0.22) -- (\x + 0.78, \y + 0.78) (\x + 0.22, \y + 0.78) -- (\x + 0.78, \y + 0.22);
}
\foreach \x/\y in {1/2, 0/1, 2/1} {
    \draw[c1, line width=2.4pt] (\x + 0.5, \y + 0.5) circle (0.3);
}
\draw[c8, line width=1.2pt, opacity=0.5] (0.1, 2.9) -- (2.9, 0.1);
\end{tikzpicture}
