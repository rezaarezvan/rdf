\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt, font=\small]
\newcommand{\bus}[3]{\draw[line width=0.5pt] ($(#1)+(-0.1,-0.17)$) -- ($(#1)+(0.1,0.17)$); \node[font=\footnotesize, #2] at (#1) {#3};}
\draw (-1.5, 9.4) rectangle (7.5, 10);
\node at (3, 9.7) {Page table register};
\node[font=\small\bfseries] at (5, 8.95) {Virtual address};
\node[anchor=west] at (-0.5, 8.45) {31 30 29 28 27 $\cdots\cdots\cdots$ 15 14 13 12};
\node[anchor=west] at (7.2, 8.45) {11 10 9 8 $\cdots$ 3 2 1 0};
\draw (0.2, 7.3) rectangle (7.2, 8.1);
\draw (7.2, 7.3) rectangle (10.4, 8.1);
\node at (3.7, 7.7) {Virtual page number};
\node at (8.8, 7.7) {Page offset};
\node at (0.4, 6.55) {Valid};
\node at (4.2, 6.55) {Physical page number};
\fill[c7, fill opacity=0.35] (0, 3.9) rectangle (7.4, 4.35);
\foreach \i in {0,...,10} \draw (0, 1.65 + \i*0.45) -- (7.4, 1.65 + \i*0.45);
\draw (0, 1.65) rectangle (7.4, 6.15);
\draw (0.45, 1.65) -- (0.45, 6.15);
\node[font=\small\bfseries, anchor=east] at (-0.3, 3.9) {Page table};
\draw[->] (-1.0, 9.4) |- (0, 6.35);
\draw[->] (1.8, 7.3) -- (1.8, 4.35);
\bus{1.8, 6.9}{right=3pt}{20}
\draw[->] (8.8, 7.3) -- (8.8, -0.75);
\bus{8.8, 6.9}{right=3pt}{12}
\fill (0.22, 4.12) circle (1.8pt);
\draw[->] (0.22, 4.12) -- (0.22, 1.2) node[below right=-2pt, align=left, xshift=-4pt] {If 0 then page is not\\present in memory};
\fill (4.2, 4.12) circle (1.8pt);
\draw[->] (4.2, 4.12) -- (4.2, -0.75);
\bus{4.2, 1.3}{right=3pt}{18}
\node[anchor=west] at (-0.5, -0.45) {29 28 27 $\cdots\cdots\cdots\cdots$ 15 14 13 12};
\node[anchor=west] at (7.2, -0.45) {11 10 9 8 $\cdots$ 3 2 1 0};
\draw (0.2, -1.55) rectangle (7.2, -0.75);
\draw (7.2, -1.55) rectangle (10.4, -0.75);
\node at (3.7, -1.15) {Physical page number};
\node at (8.8, -1.15) {Page offset};
\node[font=\small\bfseries] at (5, -2.05) {Physical address};
\end{tikzpicture}
