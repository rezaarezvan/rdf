\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt]
\newcommand{\bus}[3]{\draw[line width=0.5pt] ($(#1)+(-0.1,-0.17)$) -- ($(#1)+(0.1,0.17)$); \node[font=\small, #2] at (#1) {#3};}
\draw (0, -1.4) rectangle (0.9, 1.4);
\node at (0.45, 0) {\textbf{PC}};
\draw (2.2, 0.8) rectangle (6.4, -3.4);
\node[anchor=north west, align=left] at (2.2, 0.8) {Read\\address};
\node[anchor=east] at (6.4, -1.4) {Instruction};
\node[anchor=south west, align=left, font=\bfseries] at (2.3, -3.3) {Instruction\\memory};
\draw (6.0, 4.2) -- (6.0, 3.35) -- (6.35, 3.0) -- (6.0, 2.65) -- (6.0, 1.8) -- (7.4, 2.4) -- (7.4, 3.6) -- cycle;
\node at (6.9, 3.0) {Add};
\draw[->] (0.9, 0) -- (2.2, 0);
\fill (1.5, 0) circle (1.6pt);
\draw[->] (1.5, 0) |- (6.0, 3.8);
\bus{4.2, 3.8}{below=4pt}{32 bits}
\draw[->] (5.0, 2.2) node[left] {4} -- (6.0, 2.2);
\draw[->] (7.4, 3.0) -- (8.0, 3.0) |- (-0.9, 4.8) |- (0, 0);
\bus{7.0, 4.8}{below=4pt}{32 bits}
\draw[->] (6.4, -1.4) -- (7.9, -1.4);
\bus{7.1, -1.4}{below=4pt}{32 bits}
\node[draw, align=center] (reg) at (-2.4, -1.9) {32-bits\\register};
\draw[->, line width=0.5pt] (reg.east) -- (0, -0.8);
\end{tikzpicture}
