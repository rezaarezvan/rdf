\node[below=0.5mm of img, font=\small] {$\mathbf x$};

\newcommand{\net}[3]{%
  \begin{scope}[shift={#1}]
    \fill[white] (-0.25,-0.75) rectangle (1.85,0.75);
    \draw[rounded corners=2.5pt, line width=0.8pt] (-0.25,-0.75) rectangle (1.85,0.75);
    \foreach \a in {-0.4,0,0.4} \foreach \b [count=\k] in {-0.54,-0.18,0.18,0.54} {
      \pgfmathsetmacro{\w}{0.2 + 1.1*abs(sin(#3*\k + 90*\a))}
      \draw[c1, line width=\w pt] (0.15,\a) -- (0.8,\b);
    }
    \foreach \a [count=\k] in {-0.54,-0.18,0.18,0.54} \foreach \b in {-0.25,0.25} {
      \pgfmathsetmacro{\w}{0.2 + 1.1*abs(sin(#3*\k + 120*\b))}
      \draw[c1, line width=\w pt] (0.8,\a) -- (1.45,\b);
    }
    \foreach \y in {-0.4,0,0.4} \node[unit] at (0.15,\y) {};
    \foreach \y in {-0.54,-0.18,0.18,0.54} \node[unit] at (0.8,\y) {};
    \foreach \y in {-0.25,0.25} \node[unit] at (1.45,\y) {};
  \end{scope}
}
\coordinate (n0) at ($(img.east)+(8mm,0)$);
\foreach \d/\o in {0.3/0.35, 0.15/0.6}
  \draw[rounded corners=2.5pt, line width=0.8pt, fill=white, draw opacity=\o] ($(n0)+(\d,\d)+(-0.25,-0.75)$) rectangle ++(2.1,1.5);
\net{(n0)}{1}{13}
\coordinate (netE) at ($(n0)+(2.15,0.15)$);
\node[font=\small, text=c1] (lab) at ($(n0)+(1.0,1.55)$) {$\mathbf W + \sigma \mathbf N^{(i)}$};
\draw[flow] (img) -- ($(n0)+(-0.25,0)$);

\begin{scope}[local bounding box=hist, shift={($(netE)+(8mm,-4.5mm)$)}]
  \foreach \k/\h in {0/0.2, 1/0.95, 2/0.3, 3/0.1, 4/0.14}
    \fill[c8] (0.22*\k, 0) rectangle ++(0.17, \h);
  \draw[line width=0.6pt] (-0.05, 0) -- (1.1, 0);
\end{scope}
\node[below=0.5mm of hist, font=\small] {$\hat y_\sigma^{(i)}$};
\draw[flow] (netE) -- (netE -| hist.west);

\node[box, right=of hist] (ent) {$H_\sigma(\mathbf x)$};
\node[box, right=of ent] (met) {$\pi_\sigma, \psi_\sigma$};
\draw[flow] (hist.east |- ent) -- (ent);
\draw[flow] (ent) -- (met);
\end{tikzpicture}
