\begin{scope}[local bounding box=m0] \molxt \end{scope}
\begin{scope}[shift={($(m0.east)+(3.6,0)$)}, local bounding box=m1] \molxttau \end{scope}
\node[lab, below=1mm of m0] {$\mathbf x_{\mathfrak t}$};
\node[lab] at (m0.south -| m1) [below=1mm] {$\mathbf x_{\mathfrak t + \tau}$};
\draw[flow] ([xshift=2mm]m0.east) -- node[lab, above] {$\tau$} ([xshift=-2mm]m0.east -| m1.west);

\begin{scope}[shift={($(m0.south)+(0,-2.6)$)}, local bounding box=noise] \molnoise \end{scope}
\node[lab, below=1mm of noise] {$\mathcal N(0, \mathbf I)$};
\node[box, right=7mm of noise] (v) {$\mathbf v_\theta(\mathbf x_t \mid \mathbf x_{\mathfrak t}, t, \tau)$};
\node[lab, above=0mm of v, font=\footnotesize] {Semla};
\begin{scope}[shift={($(v.east)+(2.2,0)$)}, local bounding box=m2] \molxhat \end{scope}
\node[lab, below=1mm of m2] {$\hat{\mathbf x}_{\mathfrak t + \tau}$};
\draw[flow] (noise) -- (v);
\draw[flow] (v) -- (m2);
\draw[flow, dashed, draw=c7] (m0.south east) to[out=-40, in=140] (v.north west);
