\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt, blk/.style={draw, minimum width=20mm, minimum height=11mm, align=center}, sum/.style={draw, circle, minimum size=6mm, inner sep=0pt, path picture={\draw (path picture bounding box.north west) -- (path picture bounding box.south east) (path picture bounding box.north east) -- (path picture bounding box.south west);}}]
\node[blk] (it) at (0, 0) {Input\\transducer};
\node[sum] (s0) at (2.2, 0) {};
\node[blk] (c) at (4.4, 0) {Controller};
\node[sum] (s1) at (6.6, 0) {};
\node[blk] (p) at (8.8, 0) {Process\\or Plant};
\node[sum] (s2) at (11, 0) {};
\node[blk] (ot) at (8.8, -2.8) {Output\\transducer\\or Sensor};
\node[c8, align=center, anchor=east] at (-1.6, 0) {Input\\or\\Reference};
\draw[->] (-1.6, 0) -- (it);
\draw[->] (it) -- node[pos=0.8, above] {\small $+$} (s0);
\draw[->] (s0) -- (c);
\node[c8, align=center, above] at (3.2, 0.45) {Error\\or\\Actuating\\signal};
\draw[->] (c) -- node[pos=0.8, above] {\small $+$} (s1);
\draw[->] (s1) -- (p);
\draw[->] (p) -- node[pos=0.8, above] {\small $+$} (s2);
\draw[->] (s2) -- (13, 0) node[c8, right, align=center] {Output\\or\\Controlled\\variable};
\draw[->] (12.2, 0) |- (ot);
\draw[->] (ot) -| node[pos=0.95, left] {\small $-$} (s0);
\draw[->] (6.6, 1.4) node[c8, above] {Disturbance 1} -- node[pos=0.75, left] {\small $+$} (s1);
\draw[->] (11, 1.4) node[c8, above] {Disturbance 2} -- node[pos=0.75, left] {\small $+$} (s2);
\node[align=center] at (1.1, -1.2) {Summing\\junction};
\node[below=2mm of s1, align=center] {Summing\\junction};
\node[below=2mm of s2, align=center] {Summing\\junction};
\end{tikzpicture}
