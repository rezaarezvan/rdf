\begin{tikzpicture}[x=13mm, y=6.5mm]
\foreach \i in {0,...,3} {
  \node at (-\i, 0) {$a_\i$};
  \node at (-\i, -1) {$b_\i$};
}
\draw[line width=0.8pt] (-3.5, -1.7) -- (0.5, -1.7);
\foreach \r in {0,...,3} \foreach \i in {0,...,3} {
  \node (p\r\i) at (-\i-\r, -2.4-\r) {$b_\r a_\i$};
}
\foreach \r in {1,...,3} \foreach \i in {0,1,2}
  \draw[c1, -{Stealth[length=1.6mm]}, line width=0.7pt] (p\r\i.west) -- (p\r\the\numexpr\i+1\relax.east);
\draw[line width=0.8pt] (-7.5, -6.2) -- (0.5, -6.2);
\foreach \i in {0,...,7} \node at (-\i, -6.9) {$p_\i$};
\end{tikzpicture}
