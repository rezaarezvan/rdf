\begin{tikzpicture}[line width=0.7pt, box/.style={draw, minimum width=14mm, minimum height=9mm}]
\newcommand{\ant}[2]{\draw (#1, #2) -- ++(0, 0.5); \draw (#1, #2) ++(-0.12, 0.62) -- ++(0.12, -0.12) -- ++(0.12, 0.12);}
\foreach \name/\ntx/\nrx [count=\i] in {SISO/1/1, SIMO/1/2, MISO/2/1, MIMO/2/2} {
  \pgfmathsetmacro{\y}{-1.6*\i}
  \node[anchor=east] at (-0.4, \y) {\name};
  \node[box] (tx\i) at (0.6, \y) {Tx};
  \node[box] (rx\i) at (5.4, \y) {Rx};
  \foreach \k in {1,...,\ntx} {
    \pgfmathsetmacro{\x}{1.3 + 0.3*\k}
    \draw (tx\i.east |- 0, \y-0.3+0.2*\k) -- (\x, \y-0.3+0.2*\k) -- (\x, \y+0.05);
    \ant{\x}{\y+0.05}
  }
  \foreach \k in {1,...,\nrx} {
    \pgfmathsetmacro{\x}{4.7 - 0.3*\k}
    \draw (rx\i.west |- 0, \y-0.3+0.2*\k) -- (\x, \y-0.3+0.2*\k) -- (\x, \y+0.05);
    \ant{\x}{\y+0.05}
  }
  \draw[c8, dashed, -{Stealth[length=2mm]}] (2.3, \y+0.45) -- (3.7, \y+0.45);
}
\end{tikzpicture}
