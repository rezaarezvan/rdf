\usetikzlibrary{decorations.pathreplacing}
\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt]
\newcommand{\bus}[3]{\draw[line width=0.5pt] ($(#1)+(-0.1,-0.17)$) -- ($(#1)+(0.1,0.17)$); \node[font=\small, #2] at (#1) {#3};}
\draw (-2, -3.1) rectangle (2.2, 3.1);
\node[font=\bfseries] at (0.4, 0) {Registers};
\foreach \y/\t/\w in {2.3/Read\\register 1/5, 0.9/Read\\register 2/5, -0.5/Write\\register/5, -2.1/Write\\data/32} {
  \node[anchor=west, align=left] at (-2, \y) {\t};
  \draw[->] (-3, \y) -- (-2, \y);
  \bus{-2.55, \y}{above=4pt}{\w}
}
\foreach \y/\t in {1.6/Read\\data 1, -1.6/Read\\data 2} {
  \node[anchor=east, align=right] at (2.2, \y) {\t};
  \draw[->] (2.2, \y) -- (3.3, \y);
  \bus{2.75, \y}{below=4pt}{32}
}
\draw[decorate, decoration={brace, amplitude=6pt}] (-3.2, -1.0) -- (-3.2, 2.8) node[midway, left=8pt, align=right] {Register\\numbers};
\draw[decorate, decoration={brace, amplitude=6pt}] (-3.2, -2.7) -- (-3.2, -1.5) node[midway, left=8pt] {Data};
\draw[decorate, decoration={brace, amplitude=6pt, mirror}] (3.5, -2.0) -- (3.5, 2.0) node[midway, right=8pt] {Data};
\draw[c8] (0.4, -3.1) -- (0.4, -3.7) node[right] {RegWrite};
\begin{scope}[xshift=6.6cm]
\draw (0, 2.2) -- (0, 0.35) -- (0.4, 0) -- (0, -0.35) -- (0, -2.2) -- (2.8, -1.0) -- (2.8, 1.0) -- cycle;
\node[font=\bfseries] at (0.95, 0) {ALU};
\draw[->] (-1.0, 1.3) -- (0, 1.3);
\bus{-0.5, 1.3}{below=4pt}{32}
\draw[->] (-1.0, -1.3) -- (0, -1.3);
\bus{-0.5, -1.3}{below=4pt}{32}
\draw[c8] (1.3, 1.65) -- (1.3, 2.7) node[right] {ALU operation};
\bus{1.3, 2.15}{left=3pt}{4}
\node[c7, anchor=east] at (2.75, 0.55) {Zero};
\draw[c7, ->] (2.8, 0.55) -- (3.4, 0.55);
\node[anchor=east, align=right] at (2.75, -0.3) {ALU\\result};
\draw[->] (2.8, -0.3) -- (3.9, -0.3);
\bus{3.35, -0.3}{below=4pt}{32}
\end{scope}
\end{tikzpicture}
