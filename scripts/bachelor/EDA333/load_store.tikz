\usetikzlibrary{shapes.geometric}
\begin{tikzpicture}[>={Stealth[length=2mm]}, line width=0.7pt]
\newcommand{\bus}[3]{\draw[line width=0.5pt] ($(#1)+(-0.1,-0.17)$) -- ($(#1)+(0.1,0.17)$); \node[font=\small, #2] at (#1) {#3};}
\node[draw, minimum width=3.2cm, minimum height=3cm] (dm) at (0, 0) {};
\node[font=\bfseries, align=center] at (0.55, -0.2) {Data\\memory};
\node[anchor=west] at (-1.6, 0.9) {Address};
\node[anchor=west, align=left] at (-1.6, -0.9) {Write\\data};
\node[anchor=east, align=right] at (1.6, 0.9) {Read\\data};
\draw[->] (-2.8, 0.9) -- (-1.6, 0.9);
\bus{-2.2, 0.9}{above=4pt}{32}
\draw[->] (-2.8, -0.9) -- (-1.6, -0.9);
\bus{-2.2, -0.9}{above=4pt}{32}
\draw[->] (1.6, 0.9) -- (2.8, 0.9);
\bus{2.2, 0.9}{above=4pt}{32}
\draw[c8] (0, 1.5) -- (0, 2.1) node[right] {MemWrite};
\draw[c8] (0, -1.5) -- (0, -2.1) node[right] {MemRead};
\node[draw, ellipse, minimum width=1.7cm, minimum height=2.6cm, align=center, font=\bfseries] (se) at (5.2, 0) {Sign-\\extend};
\draw[->] (3.5, 0) -- (se.west);
\bus{3.95, 0}{above=4pt}{16}
\draw[->] (se.east) -- (7.3, 0);
\bus{6.8, 0}{above=4pt}{32}
\end{tikzpicture}
