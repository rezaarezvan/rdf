\begin{tikzpicture}[line width=0.8pt, ann/.style={c8}]
\draw (0, 0) to[american voltage source, invert, l=$v_s$] (0, 3) -- (0.4, 3) to[L, l=$L_1$] (2.4, 3) to[L, l=$L_2$] (4.4, 3) -- (4.8, 3);
\draw[dashed] (4.8, 3) -- (5.6, 3);
\draw (5.6, 3) -- (6.6, 3) to[L, l_=$L_N$] (6.6, 0) -- (5.6, 0);
\draw[dashed] (5.6, 0) -- (4.8, 0);
\draw (4.8, 0) -- (0, 0);
\draw[c8, -{Stealth[length=2mm]}] (0.3, 3.9) -- node[above] {$i$} (1.0, 3.9);
\foreach \x/\n in {1.4/1, 3.4/2} {
  \node[ann] at (\x - 0.7, 2.5) {$+$};
  \node[ann] at (\x, 2.5) {$v_\n$};
  \node[ann] at (\x + 0.7, 2.5) {$-$};
}
\node[ann] at (7.4, 2.3) {$+$};
\node[ann] at (7.4, 1.5) {$v_N$};
\node[ann] at (7.4, 0.7) {$-$};
\end{tikzpicture}
