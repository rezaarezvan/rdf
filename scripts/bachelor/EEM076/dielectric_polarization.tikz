\begin{tikzpicture}[>={Stealth[length=2.6mm]}, line width=0.8pt]
\newcommand{\dip}[3]{\begin{scope}[shift={(#1, #2)}, rotate=#3]
  \fill[c8, fill opacity=0.55] (0, 0.18) arc (90:270:0.45 and 0.18) -- cycle;
  \fill[c1, fill opacity=0.55] (0, 0.18) arc (90:-90:0.45 and 0.18) -- cycle;
  \draw[line width=0.5pt] (0, 0) ellipse (0.45 and 0.18);
  \node[scale=0.7] at (-0.22, 0) {$-$}; \node[scale=0.7] at (0.22, 0) {$+$};
\end{scope}}
\newcommand{\atom}[3]{\fill[c2, fill opacity=0.35] (#1, #2) circle (0.3); \ifnum#3=1 \node[scale=0.75] at (#1, #2) {$-\,+$}; \fi}
\newcommand{\frm}[2]{\draw[line width=0.6pt] (#1, #2) rectangle ++(4, 2.6);}
\frm{0}{3.4}
\foreach \x/\y/\a in {0.6/5.5/20, 1.6/5.6/-30, 2.8/5.4/60, 3.5/5.6/170, 0.5/4.5/100, 1.4/4.7/-150, 2.5/4.6/40, 3.4/4.4/-80, 0.8/3.8/210, 1.9/3.8/10, 3.0/3.8/130} \dip{\x}{\y}{\a}
\frm{6}{3.4}
\foreach \x/\y/\a in {6.6/5.5/10, 7.9/5.5/-5, 9.3/5.5/15, 6.6/4.7/-10, 7.9/4.7/5, 9.3/4.7/-15, 6.6/3.9/5, 7.9/3.9/15, 9.3/3.9/-25} \dip{\x}{\y}{\a}
\draw[->, c1, line width=1.4pt] (6.6, 3.0) -- (9.2, 3.0) node[right, black] {$\vec{\mathbf{E}}_0$};
\node at (5, 4.7) {Polar};
\frm{0}{0}
\foreach \x in {0.6, 1.53, 2.47, 3.4} \foreach \y in {0.5, 1.3, 2.1} \atom{\x}{\y}{0}
\node at (2, -0.4) {$\vec{\mathbf{E}}_0 = 0$};
\frm{6}{0}
\foreach \x in {6.6, 7.53, 8.47, 9.4} \foreach \y in {0.5, 1.3, 2.1} \atom{\x}{\y}{1}
\draw[->, c1, line width=1.4pt] (6.6, -0.4) -- (9.2, -0.4) node[right, black] {$\vec{\mathbf{E}}_0$};
\node at (5, 1.3) {Non-polar};
\end{tikzpicture}
