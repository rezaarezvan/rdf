\begin{tikzpicture}[>={Stealth[length=2.6mm]}, line width=0.8pt]
\newcommand{\plate}[1]{\fill[c7, fill opacity=0.35] (#1, 0) ellipse (0.25 and 1.0); \draw (#1, 0) ellipse (0.25 and 1.0);}
\fill[c7, fill opacity=0.25] (-2.5, -0.2) rectangle (1.6, 0.2);
\draw (-2.5, 0.2) -- (1.6, 0.2) (-2.5, -0.2) -- (1.6, -0.2);
\fill[c7, fill opacity=0.25] (3.8, -0.2) rectangle (5.6, 0.2);
\draw (3.8, 0.2) -- (5.6, 0.2) (3.8, -0.2) -- (5.6, -0.2);
\fill[c2, fill opacity=0.18] (0, 1.9) .. controls (2.8, 1.9) and (3.4, 0.6) .. (3.4, 0) .. controls (3.4, -0.6) and (2.8, -1.9) .. (0, -1.9) arc (-90:90:0.5 and 1.9);
\draw (0, 1.9) .. controls (2.8, 1.9) and (3.4, 0.6) .. (3.4, 0) .. controls (3.4, -0.6) and (2.8, -1.9) .. (0, -1.9);
\fill[c2, fill opacity=0.3] (0, 0) ellipse (0.5 and 1.9);
\draw (0, 0) ellipse (0.5 and 1.9);
\plate{1.8} \plate{3.6}
\node at (1.8, -0.55) {$Q$}; \node[right] at (3.85, -0.6) {$-Q$};
\node at (0.05, -1.2) {$S_1$}; \node at (1.1, -1.4) {$S_2$};
\node at (3.6, 1.3) {$A$};
\draw[->, c1, line width=1.4pt] (-2.4, 0.55) -- (-1.3, 0.55) node[midway, above] {$I$};
\draw[<-, line width=0.5pt] (-0.35, 1.5) -- (-1.2, 2.3) node[above left] {Curve $C$};
\draw[<-, line width=0.5pt] (1.95, -0.85) -- (2.9, -2.1);
\draw[<-, line width=0.5pt] (3.65, -1.0) -- (3.1, -2.1) node[below] {Capacitor plates};
\foreach \y in {-0.6, -0.3, 0, 0.3, 0.6} \draw[->, c1, line width=1pt] (2.1, \y) -- (3.3, \y);
\node[c1] at (2.7, 0.95) {$\vec{E}$};
\end{tikzpicture}
