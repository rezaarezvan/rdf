\begin{tikzpicture}[>={Stealth[length=2.6mm]}, line width=0.8pt, scale=2.2]
\draw[->] (-1.3, 0) -- (1.4, 0) node[right] {Re};
\draw[->] (0, -1.25) -- (0, 1.35) node[left] {Im};
\draw (0, 0) circle (1);
\draw[->, c8, line width=1.1pt] (0, 0) -- (65:1);
\draw[c1] (65:1) -- (0.4226, 0) node[pos=0.72, right] {$\sin \varphi$};
\draw (0.3, 0) arc (0:65:0.3);
\node at (32:0.44) {$\varphi$};
\node[below left] at (0, 0) {$0$};
\node[below] at (0.21, 0) {$\cos \varphi$};
\node[below right] at (1, 0) {$1$};
\node[below left] at (0, 1) {$j$};
\node[right] at (0.1, 1.2) {$e^{j\varphi} = \cos \varphi + j \sin \varphi$};
\end{tikzpicture}
